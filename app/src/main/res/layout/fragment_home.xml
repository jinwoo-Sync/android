<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".ui.home.HomeFragment">

        <!-- 상태 메시지 -->
        <TextView
            android:id="@+id/text_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:textAlignment="center"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="카메라 미리보기 대기 중..." />

        <!-- 카메라 프리뷰와 오버레이를 위한 FrameLayout -->
        <FrameLayout
            android:id="@+id/camera_preview_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_home"
            app:layout_constraintHeight_percent="0.35">

            <!--  GLSurfaceView 사용 -->
            <android.opengl.GLSurfaceView
                android:id="@+id/glSurfaceView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Camera Preview" />

            <!-- 바운딩 박스를 그릴 OverlayView -->
            <com.example.myapplication.learning.yolo.OverlayView
                android:id="@+id/overlayView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

        <!-- 추론 시간 표시 -->
        <TextView
            android:id="@+id/inference_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:textSize="10sp"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/camera_preview_container"
            tools:text="Inference: 0ms" />

        <!--  비트맵 풀 상태 표시 -->
        <TextView
            android:id="@+id/pool_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:textSize="8sp"
            android:maxLines="3"
            android:ellipsize="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/inference_time"
            tools:text="Pool: Available=2, Active=4" />

        <!-- GPS 로그 -->
        <TextView
            android:id="@+id/gps_log_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:textSize="10sp"
            android:maxLines="2"
            android:ellipsize="none"
            android:scrollbars="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pool_status_text"
            tools:text="GPS: 대기 중" />

        <TextView
            android:id="@+id/gnss_log_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/gps_log_text"
            tools:text="GNSS: 대기 중" />

        <!-- IMU 로그 -->
        <TextView
            android:id="@+id/imu_log_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/gnss_log_text"
            tools:text="IMU: 대기 중" />

        <!-- 메인 버튼 레이아웃 -->
        <LinearLayout
            android:id="@+id/buttonLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintTop_toBottomOf="@id/imu_log_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <Button
                android:id="@+id/button_open_camera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="스트리밍 시작"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/button_capture_frame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="프레임 캡처"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

        </LinearLayout>

        <!-- 풀 관리 버튼 레이아웃 -->
        <LinearLayout
            android:id="@+id/poolControlLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintTop_toBottomOf="@id/buttonLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <Button
                android:id="@+id/button_cleanup_pool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="풀 정리"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/button_pool_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="풀 상태"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- 설정 및 컨트롤 레이아웃 -->
        <LinearLayout
            android:id="@+id/controlLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/poolControlLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <CheckBox
                android:id="@+id/loggingCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="핸드폰에 저장" />

            <CheckBox
                android:id="@+id/streamingCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="서버로 전송"
                android:layout_below="@id/loggingCheckbox" />

            <!-- EditText와 Button을 위한 수평 LinearLayout 추가 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/editTextFrameSkip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Enter frame skip interval"
                    android:inputType="number"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/buttonSetFrameSkip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Set Frame Skip" />

            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>